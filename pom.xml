<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>HobbyProject</groupId>
    <artifactId>Game</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <repositories>
        <repository>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>central</id>
            <name>bintray</name>
            <url>https://jcenter.bintray.com</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>19</version>
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20230618</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>21.0.2</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.9</version>
        </dependency>

        <!-- JInput: Java Controller Input API -->
        <dependency>
            <groupId>net.java.jinput</groupId>
            <artifactId>jinput</artifactId>
            <version>2.0.10</version>
        </dependency>

        <!-- JInput Native Libraries -->
        <dependency>
            <groupId>net.java.jinput</groupId>
            <artifactId>jinput-platform</artifactId>
            <version>2.0.5</version>
            <type>pom</type>
        </dependency>

        <dependency>
            <groupId>net.java.jinput</groupId>
            <artifactId>osx-plugin</artifactId>
            <version>2.0.10</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.0</version>
        </dependency>


    </dependencies>

    <profiles>
        <!-- Profile for hardware acceleration ENABLED (default, best performance) -->
        <profile>
            <id>hw-accel</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <app.name>Game</app.name>
                <opengl.enabled>true</opengl.enabled>
            </properties>
        </profile>

        <!-- Profile for hardware acceleration DISABLED (compatibility mode) -->
        <profile>
            <id>no-hw-accel</id>
            <properties>
                <app.name>Game-SoftwareRenderer</app.name>
                <opengl.enabled>false</opengl.enabled>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>


            <plugin>
                <groupId>com.googlecode.mavennatives</groupId>
                <artifactId>maven-nativedependencies-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>net.riezebos.bruus.tbd.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <name>${app.name}</name>
                    <appVersion>1.0</appVersion>
                    <vendor>Bruus Riezebos</vendor>
                    <destination>target/dist</destination>
                    <input>target/jpackage-input</input>
                    <mainJar>Game-0.0.1-SNAPSHOT.jar</mainJar>
                    <mainClass>net.riezebos.bruus.tbd.Main</mainClass>
                    <javaOptions>
                        <option>-Djava.library.path=$APPDIR/lib</option>
                        <option>-Xms4g</option>
                        <option>-Xmx8g</option>
                        <option>-XX:+UseG1GC</option>
                        <option>-Dsun.java2d.opengl=${opengl.enabled}</option>
                        <option>-Dsun.java2d.d3d=${opengl.enabled}</option>
                        <option>-Dsun.java2d.metal=${opengl.enabled}</option>
                        <option>-Dsun.java2d.accthresh=0</option>
                    </javaOptions>
                    <resourceDir>src/main/resources</resourceDir>
                    <!-- Options: APP_IMAGE, DMG (macOS), PKG (macOS), EXE (Windows), MSI (Windows), DEB (Linux), RPM (Linux) -->
                    <!-- APP_IMAGE = no installer needed, just extract and run -->
                    <type>APP_IMAGE</type>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>copy-natives</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>target/jpackage-input/lib</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/libraries</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>target/jpackage-input</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>target</directory>
                                    <includes>
                                        <include>Game-0.0.1-SNAPSHOT.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>